{
  "name": "dsh-spotlight",
  "version": "1.0.1",
  "description": "Spotlight-style command palette for DeepSeek Harness: settings, plugins, sessions, keyboard shortcuts, themes, and any registered command.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/verify.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "spotlight",
    "command-palette",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "hakulat2023",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakulat2023/dsh-spotlight.git"
  },
  "homepage": "https://github.com/hakulat2023/dsh-spotlight#readme",
  "bugs": {
    "url": "https://github.com/hakulat2023/dsh-spotlight/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
